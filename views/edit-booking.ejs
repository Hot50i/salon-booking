<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Booking</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <h1>Edit Appointment</h1>

  <form action="/bookings/<%= booking._id %>/edit" method="POST">

    <label for="name">Your Name</label>
    <input
      type="text"
      id="name"
      name="name"
      value="<%= booking.name %>"
      required
    >

    <br><br>

    <label for="email">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      value="<%= booking.email %>"
      required
    >

    <br><br>

    <label for="phone">Phone</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      value="<%= booking.phone %>"
      required
    >

    <br><br>

    <label for="service">Service</label>
    <select id="service" name="service" required>

      <option value="Braiding" <%= booking.service === "Braiding" ? "selected" : "" %>>
        Braiding
      </option>

      <option value="Haircut" <%= booking.service === "Haircut" ? "selected" : "" %>>
        Haircut
      </option>

      <option value="Manicure" <%= booking.service === "Manicure" ? "selected" : "" %>>
        Manicure
      </option>

    </select>

    <br><br>

    <label for="date">Date</label>
    <input
      type="date"
      id="date"
      name="date"
      value="<%= booking.date %>"
      required
    >

    <br><br>

    <label for="time">Time</label>
    <input
      type="time"
      id="time"
      name="time"
      value="<%= booking.time %>"
      required
    >

    <br><br>

    <button type="submit">Update Booking</button>

  </form>

</body>
</html>