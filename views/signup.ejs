

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign Up - My Salon</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <main class="auth-page">

        <section class="auth-card">

            <!-- Salon name -->
            <h1 class="auth-title">
                My Salon
            </h1>

            <p class="auth-subtitle">
                Create an account to book your salon appointments
            </p>


            <!-- Sign Up Form -->
            <form action="/signup" method="POST" class="auth-form">

                <!-- Name -->
                <div class="form-group">

                    <label for="name" class="form-label">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        required
                    >

                </div>


                <!-- Email -->
                <div class="form-group">

                    <label for="email" class="form-label">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>


                <!-- Password -->
                <div class="form-group">

                    <label for="password" class="form-label">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-input"
                        placeholder="Create a password"
                        autocomplete="new-password"
                        required
                    >

                </div>


                <!-- Sign Up button -->
                <button
                    type="submit"
                    class="btn btn-primary btn-block">
                    Sign Up
                </button>

            </form>


            <!-- Login link -->
            <div class="auth-footer">

                Already have an account?

                <a href="/login" class="auth-link">
                    Log in
                </a>

            </div>

        </section>

    </main>

</body>

</html>

