
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Verify Your Email - My Salon</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<main class="auth-page">

    <section class="auth-card">

        <h1 class="auth-title">
            Verify Your Email
        </h1>

        <p class="auth-subtitle">
            We sent a 6-digit verification code to your email address.
            Enter the code below to complete your My Salon account.
        </p>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

        <% if (typeof message !== "undefined" && message) { %>
            <div class="alert alert-success">
                <%= message %>
            </div>
        <% } %>

        <form action="/signup-verification" method="POST" class="auth-form">

            <div class="form-group">

                <label for="code" class="form-label">
                    Verification Code
                </label>

                <input
                    type="text"
                    id="code"
                    name="code"
                    class="form-input"
                    placeholder="Enter your 6-digit code"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    maxlength="6"
                    pattern="[0-9]{6}"
                    required
                >

                <small class="form-hint">
                    The code is valid for a limited time.
                </small>

            </div>

            <button
                type="submit"
                class="btn btn-primary btn-block"
            >
                Verify Email
            </button>

        </form>

        <p class="auth-footer">
            Didn't receive the code?
            <a href="/signup" class="auth-link">
                Sign up again
            </a>
        </p>

    </section>

</main>

</body>

</html>
